repositories:

# general packages
  athena_custom_msgs_pkg:
    type: git
    url: https://github.com/Autonomous-System-ZHAW/athena-custom-msgs-pkg.git 
    version: main
    path: athena_custom_msgs_pkg

  athena_common:
    type: git
    url: https://github.com/Autonomous-System-ZHAW/athena_common.git
    version: main
    path: athena_common

  athena_description:
    type: git
    url: https://github.com/Autonomous-System-ZHAW/athena_description.git
    version: main
    path: athena_description

  foxglove-visualizer:
    type: git
    url: https://github.com/Autonomous-System-ZHAW/foxglove_visualizer.git
    version: main
    path: foxglove-visualizer

  athena_lifecycle_state_machine:
    type: git
    url: https://github.com/Autonomous-System-ZHAW/athena_lifecycle_state_machine.git
    version: mission-selection
    path: athena_lifecycle_state_machine

  athena_remote_control:
    type: git
    url: https://github.com/Autonomous-System-ZHAW/athena_remote_control.git
    version: main
    path: athena_remote_control

# hardware
  athena_led_manager:
    type: git
    url: https://github.com/Autonomous-System-ZHAW/athena_led_manager.git
    version: main
    path: athena_led_manager

# algorithms
  athena_follow_the_gap:
    type: git
    url: https://github.com/Autonomous-System-ZHAW/athena_follow_the_gap.git 
    version: simulation-FTG
    path: follow_the_gap

  mpc_controller:
    type: git
    url: https://git@github.com/Autonomous-System-ZHAW/mpc_controller.git 
    version: simulation-MPC 
    path: mpc_controller


